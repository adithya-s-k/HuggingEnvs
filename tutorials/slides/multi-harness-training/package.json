    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "pptxgenjs": "^3.12.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
