{
  "name": "multi-harness-training-slides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-Harness Training (OpenEnv × Harbor) — talk slides. React deck, dark/light, arrow-key navigation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
