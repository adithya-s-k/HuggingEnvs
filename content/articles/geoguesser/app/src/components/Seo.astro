---
interface Props {
  title: string;
  description?: string;
  authors?: string[];
  /** Human-readable date, as written in the frontmatter. */
  published?: string;
  /** ISO 8601, for `article:published_time` and schema.org. */
  publishedIso?: string;
  modified?: string;
  modifiedIso?: string;
  tags?: string[];
  image?: string; // Preferred absolute URL
  /** Publication name for `og:site_name`. */
  siteName?: string;
  /** Canonical URL override, for a page served under a different origin. */
  canonical?: string;
}

const {
  title,
  description = "",
  authors = [],
  published,
  publishedIso,
  modified,
  modifiedIso,
  tags = [],
  image,
  siteName,
  canonical,
} = Astro.props as Props;

// Canonical must be the deployed origin, not the build host: `Astro.url` is
// `http://localhost:4321/` during a static build, which is how this page
// shipped with a canonical pointing at a dev server.
const site = (Astro.site ? String(Astro.site) : "") as string;
const path = Astro.url?.pathname ?? "/";
const url = canonical || (site ? new URL(path, site).toString() : (Astro.url?.toString?.() ?? ""));
// Build base URL: prefer Astro.site, fallback to origin from Astro.url
const baseUrl = site || (Astro.url ? `${Astro.url.protocol}//${Astro.url.host}` : "");

const ogImage =
  image && image.length > 0
    ? image.startsWith("http")
      ? image
      : baseUrl
        ? new URL(image, baseUrl).toString()
        : image
    : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description || undefined,
  datePublished: publishedIso || published || undefined,
  dateModified: modifiedIso || modified || publishedIso || published || undefined,
  author: authors.map((name) => ({ "@type": "Person", name })),
  publisher: {
    "@type": "Organization",
    name: "Hugging Face",
    url: "https://huggingface.co",
  },
  keywords: tags.length ? tags.join(", ") : undefined,
  mainEntityOfPage: url || undefined,
  image: ogImage ? [ogImage] : undefined,
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={url} />
<meta property="og:locale" content="en_US" />
{siteName && <meta property="og:site_name" content={siteName} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={title} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && ogImage.endsWith(".jpg") && (
  <meta property="og:image:type" content="image/jpeg" />
)}
{(publishedIso || published) && (
  <meta property="article:published_time" content={publishedIso || published} />
)}
{(modifiedIso || modified) && (
  <meta property="article:modified_time" content={modifiedIso || modified} />
)}
{tags.map((tagName) => <meta property="article:tag" content={tagName} />)}
{tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
{authors.map((a) => <meta property="article:author" content={a} />)}

<meta
  name="twitter:card"
  content={ogImage ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={title} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
